# Server-only DeepSeek configuration. Never commit a real .env file.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_PROVIDERS=deepseek,openai,qwen,custom
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=
CUSTOM_AI_MODEL=
AI_REQUEST_TIMEOUT_MS=15000
AI_MAX_INPUT_CHARS=12000
AI_MAX_OUTPUT_TOKENS=800
AI_RATE_LIMIT=30
AI_RATE_WINDOW_MS=3600000
AI_INPUT_COST_PER_MILLION=0.27
AI_OUTPUT_COST_PER_MILLION=1.10
