# Server-only DeepSeek configuration. Never commit a real .env file.
# Local PostgreSQL is required before running migrations.
DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5432/ai_growth_os
# Local development exposes a one-time verification URL; set false in production and connect a mail provider.
AUTH_DEV_MODE=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_PROVIDERS=deepseek,openai,qwen,custom
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=
CUSTOM_AI_MODEL=
AI_REQUEST_TIMEOUT_MS=15000
AI_MAX_INPUT_CHARS=12000
AI_MAX_OUTPUT_TOKENS=2400
AI_RATE_LIMIT=30
AI_RATE_WINDOW_MS=3600000
AI_INPUT_COST_PER_MILLION=0.27
AI_OUTPUT_COST_PER_MILLION=1.10
